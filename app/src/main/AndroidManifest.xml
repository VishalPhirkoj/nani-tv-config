<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Auto-start (AutoStart.kt): boot + screen on pe app saamne laana -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Background se activity kholne ke liye. TV pe adb se grant:
         adb shell appops set tv.nani.launcher SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Android 11+ package visibility. Bina iske setPackage() wala
      deep link silently fail hota hai. Naya OTT app add karo toh
      yahan uska package bhi add karna.
    -->
    <queries>
        <package android:name="in.startv.hotstar" />
        <package android:name="com.graymatrix.did" />
        <package android:name="ahaflix.tv" />
        <package android:name="com.suntv.sunnxt" />
        <package android:name="com.etvwin.androidtv" />
        <package android:name="com.sonyliv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="org.smarttube.stable" />
        <package android:name="com.jio.media.stb.ondemand" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NaniTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.NaniTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- HOME candidate. Haier firmware Home button pe ise ignore karke hamesha
                 Android TV launcher kholta hai — asli kaam HomeWatcher karta hai.
                 Phir bhi rakha hai: default-home role isi se milta hai. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Kuch TV/vendor fast-boot pe ye bhejte hain -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Brings the TV launcher to the front when the screen turns on" />
        </service>

        <!-- Home button → Nani TV (HomeWatcher.kt). adb se enable hota hai. -->
        <service
            android:name=".HomeWatcher"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_watcher" />
        </service>
    </application>
</manifest>
